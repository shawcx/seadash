# Runs unchanged under python3 and seadash (bench/python/seadash.py stands in for @value).
# A @value class holding a list: created every step, and looped over to read.
from dataclasses import dataclass
from seadash import value


@value
@dataclass
class Particle:
    x: float
    y: float
    vx: float
    vy: float
    weights: list[float]


def step(ps: list[Particle], dt: float) -> list[Particle]:
    out: list[Particle] = []
    for p in ps:
        vy = p.vy - 9.8 * dt
        out.append(Particle(p.x + p.vx * dt, p.y + vy * dt, p.vx * 0.999, vy, p.weights))
    return out


def energy(ps: list[Particle]) -> float:
    total = 0.0
    for p in ps:
        total += 0.5 * (p.vx * p.vx + p.vy * p.vy) * p.weights[0] + p.y * sum(p.weights)
    return total


def main():
    ps: list[Particle] = []
    for i in range(5000):
        f = float(i)
        ps.append(Particle(f, f * 0.5, 1.0 + f / 1000.0, 0.0, [1.0 + (i % 3), 0.5, 0.25, 0.125]))
    energies: list[float] = []
    for _ in range(600):
        ps = step(ps, 0.001)
        energies.append(energy(ps))
    print(len(ps), round(energies[0], 3), round(energies[-1], 3), round(ps[0].y, 6))


main()
