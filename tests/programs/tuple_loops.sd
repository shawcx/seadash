# Looping over tuples: the loop variable has the type all the items share.
from dataclasses import dataclass


@dataclass
class Animal:
    name: str

    def speak(self) -> str:
        return "..."


class Dog(Animal):
    def speak(self) -> str:
        return "woof"


class Cat(Animal):
    def speak(self) -> str:
        return "meow"


@dataclass
class Log:
    items: list[str]


def calls(log: Log, n: int) -> int:
    log.items.append(f"call {n}")
    return n


for size in (1, 3, 0):
    print("size", size)

point = (3, 4)
for coord in point:
    print(coord * coord)

for x in (1.5, 2.5):
    print(x, x / 2)

for pet in (Dog("rex"), Cat("tom")):  # their common base class
    print(pet.name, pet.speak())

for maybe in (1, None, 3):
    if maybe is None:
        print("nothing")
    else:
        print(maybe + 1)

for word in ("a", "b"):
    for i, ch in enumerate(("x", "y")):
        print(word, i, ch)

print([n * 10 for n in (1, 2, 3)], sorted({s.upper() for s in ("p", "q", "p")}))
print(sum((1, 2, 3)), max((4, 9, 2)), sorted(("pear", "fig", "apple")), list((1, 2)))
print(list(reversed((1, 2, 3))), list(zip((1, 2), ("a", "b"))), ",".join(("x", "y", "z")))
print(any((False, True)), all((True, False)), min(("b", "a")), set((2, 1, 2)) == {1, 2})
print(bytes((104, 105)))

log = Log([])
print(sum((calls(log, 1), calls(log, 2))), max(calls(log, 3), calls(log, 4)), log.items)

total = 0
for t in (point, (5, 6)):  # a tuple of tuples
    for v in t:
        total += v
print(total)
