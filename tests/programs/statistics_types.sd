# seadash-only: where Python's statistics results are ints (or keep the data's type) and
# seadash's are floats, because a static type can't depend on whether a mean is whole.
import statistics

print(statistics.mean([1, 2, 3]), statistics.median([3, 1, 2]), statistics.median([1, 2, 3, 5]))  # Python: 2 2 2.5
print(statistics.variance([1, 2, 3]), statistics.pvariance([1, 3]), statistics.harmonic_mean([2]))  # Python: 1 1 2
print(statistics.harmonic_mean([2.5, 0, 10]), statistics.quantiles([4], n=3))  # Python: 0 [4, 4]
print(statistics.mean({4, 5, 6}), statistics.median(x * x for x in range(4)))  # Python: 5 2.5
try:
    statistics.geometric_mean([1, -2])
except statistics.StatisticsError as e:
    print(e)  # ('No negative inputs allowed', -2)
try:
    statistics.geometric_mean([1.5, -2.5])
except statistics.StatisticsError as e:
    print(e)  # ('No negative inputs allowed', -2.5)
print(statistics.mode([(1, "a"), (2, "b"), (1, "a")]), statistics.multimode(w for w in "a b a b c".split()))
