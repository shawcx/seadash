# Float arithmetic rounds after every operation, as in Python: a * b + c is never fused
# into one step (which C++ compilers do by default on arm64).
def muladd(a: float, b: float, c: float) -> float:
    return a * b + c

xs = [0.1, 10.0, -1.0]
print(muladd(xs[0], xs[1], xs[2]), xs[0] * xs[1] - 1.0)
total = 0.0
for i in range(1, 6):
    total += (0.1 * i) * (0.7 * i) - 0.07 * i * i
print(total)
dot = 0.0
for i in range(10):
    dot += (i / 3) * (i / 7)
print(dot, sum([(i / 3) * (i / 7) for i in range(10)]))
