# http.server: a BaseHTTPRequestHandler subclass on HTTPServer and ThreadingHTTPServer, checked
# with raw requests (Python's exact responses, errors and log calls) and with http.client.
import http.client
import re
import socket
import threading
from concurrent.futures import ThreadPoolExecutor
from http.server import BaseHTTPRequestHandler, HTTPServer, ThreadingHTTPServer
from seadash import Atomic


class Handler(BaseHTTPRequestHandler):
    server_version = "Test/1.0"

    def do_GET(self):
        if self.path == "/missing":
            self.send_error(404)
            return
        if self.path == "/teapot":
            self.send_error(418, "Teapot here", "longer <explain>")
            return
        body = f"{self.command} {self.path} {self.request_version} {self.headers.get('X-A')} {self.client_address[0]}\n"
        data = body.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        length = self.headers["Content-Length"]
        data = self.rfile.read(int(length) if length is not None else 0)
        self.send_response(201, "Made")
        self.end_headers()
        self.wfile.write(data.upper())

    def do_HEAD(self):
        self.send_response(204)
        self.end_headers()

    def log_message(self, format: str, *args: str) -> None:
        print("log:", format, [str(a) for a in args])


def raw(port: int, request: bytes) -> None:
    with socket.create_connection(("127.0.0.1", port)) as s:
        s.sendall(request)
        reply = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            reply += chunk
    text = reply.decode("latin-1")
    text = re.sub(r"Date: [^\r]*", "Date: X", text)
    text = re.sub(r"Server: ([^ ]*) [^\r]*", r"Server: \1 X", text)  # (Python names its version; seadash, its own)
    print(repr(text))


with HTTPServer(("127.0.0.1", 0), Handler) as server:
    port = server.server_address[1]
    t = threading.Thread(target=server.serve_forever)
    t.start()
    raw(port, b"GET /x?q=1 HTTP/1.1\r\nHost: a\r\nX-A: hi\r\n\r\n")
    raw(port, b"GET /missing HTTP/1.1\r\n\r\n")
    raw(port, b"GET /teapot HTTP/1.0\r\n\r\n")
    raw(port, b"POST /p HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello")
    raw(port, b"HEAD /h HTTP/1.1\r\n\r\n")
    raw(port, b"PUT /x HTTP/1.1\r\n\r\n")
    raw(port, b"BOGUS\r\n\r\n")
    raw(port, b"GET / HTTP/2.0\r\n\r\n")
    raw(port, b"GET /\r\n\r\n")
    raw(port, b"POST /\r\n\r\n")
    raw(port, b"GET / HTTP/1.1 extra\r\n\r\n")
    raw(port, b"GET / FTP/1.1\r\n\r\n")
    raw(port, b"GET / HTTP/1.x\r\n\r\n")
    raw(port, b"\r\n")
    raw(port, b"GET //evil.example/path HTTP/1.1\r\nBad header line\r\nX-A: two\r\n\r\n")
    raw(port, b"get / HTTP/1.1\r\n\r\n")
    conn = http.client.HTTPConnection("127.0.0.1", port)
    conn.request("GET", "/via-client", headers={"X-A": "c"})
    r = conn.getresponse()
    print(r.status, r.reason, r.getheader("Content-Type"), str(r.getheader("Server")).split()[0], r.read())
    conn.request("POST", "/echo", body=b"abc")
    r = conn.getresponse()
    print(r.status, r.reason, r.read())
    conn.close()
    server.shutdown()
    t.join()


class KeepAlive(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_GET(self):
        data = self.path.encode()
        self.send_response(200)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, format: str, *args: str) -> None:
        pass


hits = Atomic()


class Counting(BaseHTTPRequestHandler):
    def do_GET(self):
        n = hits.add(1)
        data = f"{n}".encode()
        self.send_response(200)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, format: str, *args: str) -> None:
        pass


def fetch(port: int, count: int) -> int:
    conn = http.client.HTTPConnection("127.0.0.1", port)
    total = 0
    for i in range(count):
        conn.request("GET", f"/{i}")
        total += len(conn.getresponse().read())
    conn.close()
    return total


with HTTPServer(("127.0.0.1", 0), KeepAlive) as server:
    t = threading.Thread(target=server.serve_forever)
    t.start()
    conn = http.client.HTTPConnection("127.0.0.1", server.server_address[1])
    for path in ["/one", "/two", "/three"]:  # one connection: HTTP/1.1 keeps it open
        conn.request("GET", path)
        r = conn.getresponse()
        print(r.version, r.status, r.getheader("Connection"), r.read())
    conn.close()
    raw(server.server_address[1], b"GET /expect HTTP/1.1\r\nExpect: 100-continue\r\nConnection: close\r\n\r\n")
    server.shutdown()
    t.join()

with ThreadingHTTPServer(("127.0.0.1", 0), Counting) as server:
    t = threading.Thread(target=server.serve_forever)
    t.start()
    with ThreadPoolExecutor(max_workers=8) as pool:
        sizes = [pool.submit(fetch, server.server_address[1], 25) for _ in range(8)]
        print(sum(f.result() for f in sizes) > 0, hits.get())
    server.shutdown()
    t.join()

with HTTPServer(("127.0.0.1", 0), KeepAlive) as server:  # handle_request(): just one
    one = threading.Thread(target=server.handle_request)
    one.start()
    raw(server.server_address[1], b"GET /once HTTP/1.0\r\n\r\n")
    one.join()
print(Handler.server_version, KeepAlive.protocol_version, Counting.protocol_version)
