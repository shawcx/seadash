# closures share variables with the function that created them, like Python

from seadash import value

def make_counters() -> list[() -> int]:
    fns: list[() -> int] = []
    for i in range(3):
        fns.append(lambda: i * 10)   # all three share `i`, so all see its final value
    return fns

print([f() for f in make_counters()])

x = 1
get_x: () -> int = lambda: x
x = 2
print(get_x(), x)                     # the lambda sees the updated x

class Button:
    label: str
    on_click: (str) -> None

    def click(self):
        self.on_click(self.label)

    def handler(self) -> () -> None:
        return lambda: print("clicked", self.label)

log: list[str] = []
b = Button("ok", lambda label: log.append(label))   # `log` is a global: shared, not copied
b.click()
b.click()
print(log)
h = b.handler()
b.label = "renamed"
h()                                   # classes are shared references, so it sees the rename

@value
class Temperature:
    celsius: float

    def formatter(self) -> (str) -> str:
        return lambda unit: f"{self.celsius}{unit}"

t = Temperature(21.5)
fmt = t.formatter()
t.celsius = 30
print(fmt("C"), t.celsius)            # but `self` in a @value class is a value: the lambda has a copy

tick = Button("x", lambda s: None).click
tick()
maybe: ((int) -> int)? = None
if maybe is None:
    maybe = lambda n: n + 1
print(maybe(41))

def pipeline(value: int, steps: list[(int) -> int]) -> int:
    for step in steps:
        value = step(value)
    return value

print(pipeline(3, [lambda v: v + 1, lambda v: v * v, abs]))
