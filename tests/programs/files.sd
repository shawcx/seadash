import os

with open("data.txt", "w") as f:
    f.write("alpha\n")
    f.writelines(["beta\n", "gamma\n"])
    print("delta", 4, sep=":", file=f)

with open("data.txt") as f:
    print(repr(f.readline()))
    print(f.readlines())

with open("data.txt") as f:
    words = [line.strip() for line in f]
print(words)

with open("data.txt", "a") as f:
    f.write("epsilon\n")
with open("data.txt") as f:
    content = f.read()
print(len(content), content.count("\n"), content.splitlines()[-1])

with open("data.txt") as f:
    print(f.read(5), "|", f.read(3), "|", repr(f.readline()))

with open("blob.bin", "wb") as f:
    f.write(bytes(range(10)) + b"\xff\n\x00end")
with open("blob.bin", "rb") as f:
    data = f.read()
print(data, len(data), data[-3:])
with open("blob.bin", "rb") as f:
    print([len(chunk) for chunk in f])

try:
    open("missing.txt")
except FileNotFoundError as e:
    print("not found:", e)
try:
    with open("data.txt", "x") as f:
        pass
except FileExistsError as e:
    print("exists:", e)

g = open("data.txt")
g.close()
try:
    g.read()
except ValueError as e:
    print("closed:", e)

def count_until_g(path: str) -> int:
    n = 0
    with open(path) as f:
        for line in f:
            if line.startswith("g"):
                return n
            n += 1
    return n

print(count_until_g("data.txt"))

with open("a.txt", "w") as a, open("b.txt", "w") as b:
    a.write("A")
    b.write("B")
with open("a.txt") as a, open("b.txt") as b:
    print(a.read() + b.read())

os.mkdir("sub")
os.makedirs("sub/deeper/still", exist_ok=True)
os.makedirs("sub/deeper/still", exist_ok=True)
with open(os.path.join("sub", "deeper", "x.txt"), "w") as f:
    f.write("hi")
print(sorted(os.listdir("sub")), sorted(os.listdir(os.path.join("sub", "deeper"))))
p = os.path.join("sub", "deeper", "x.txt")
print(os.path.exists(p), os.path.isfile(p), os.path.isdir("sub"), os.path.getsize(p))
print(os.path.basename(p), os.path.dirname(p), os.path.splitext("archive.tar.gz"), os.path.splitext(".bashrc"))
os.rename(p, "sub/y.txt")
print(os.path.exists(p), os.path.exists("sub/y.txt"))
os.remove("sub/y.txt")
try:
    os.remove("sub/y.txt")
except FileNotFoundError as e:
    print("remove:", e)
try:
    os.mkdir("sub")
except FileExistsError as e:
    print("mkdir:", e)
print(os.getenv("SEADASH_SURELY_UNSET"), os.getenv("SEADASH_SURELY_UNSET", "default"))
print(os.path.join("a", "/abs", "b"), os.path.join("a", ""), os.path.abspath("x") == os.path.join(os.getcwd(), "x"))
