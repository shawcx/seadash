xs = [5, 3, 8]
xs.append(1)
xs.insert(0, 10)
print(xs, len(xs), xs[0], xs[-1])
print(xs.pop(), xs.pop(0), xs)
xs.sort()
print(xs, sorted(xs, reverse=True), xs.index(8), xs.count(3))
xs.reverse()
print(xs)
xs.extend([7, 7])
xs.remove(7)
print(xs, 7 in xs, 99 not in xs)
xs[1] = 100
xs[-1] += 1
print(xs, xs[1:3], xs[::-1], xs[:])

squares = [x * x for x in range(6)]
evens = [x for x in squares if x % 2 == 0]
pairs = [(i, c) for i, c in enumerate("ab")]
grid = [[r * 3 + c for c in range(3)] for r in range(2)]
flat = [v for row in grid for v in row]
print(squares, evens, pairs, grid, flat)
print(sum(squares), min(squares), max(squares), sum(x / 2 for x in range(4)))
print(any(x > 20 for x in squares), all(x >= 0 for x in squares))
for i, name in enumerate(["ann", "bob"], 1):
    print(i, name)
for a, b in zip([1, 2, 3], ["x", "y"]):
    print(a, b)
print(list(reversed([1, 2, 3])), [1, 2] + [3], [0] * 3)
matrix: list[list[float]] = []
matrix.append([1.0, 2])
matrix[0].append(3)
print(matrix)

ys = xs
ys.append(-1)
print(len(xs), len(ys))  # ys is the same list, as in Python
