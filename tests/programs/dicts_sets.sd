ages = {"ann": 31, "bob": 25}
ages["cy"] = 40
ages["ann"] += 1
print(ages, len(ages), ages["bob"])
print("bob" in ages, "zed" in ages, ages.get("zed"), ages.get("zed", 0), ages.get("cy"))
for name in ages:
    print(name, ages[name])
for name, age in ages.items():
    print(f"{name} is {age}")
print(list(ages.keys()), list(ages.values()))
print(ages.pop("bob"), ages)
ages.setdefault("dee", 1)
ages.update({"ann": 0, "eve": 5})
print(ages)

counts: dict[str, int] = {}
for word in "a b a c b a".split():
    counts[word] = counts.get(word, 0) + 1
print(counts)
by_len = {w: len(w) for w in ["hi", "hello", "hey"]}
print(by_len)

groups: dict[int, list[str]] = {}
for w in ["hi", "yo", "hey"]:
    groups.setdefault(len(w), []).append(w)
print(groups)

s = {3, 1, 2}
s.add(5)
s.discard(1)
print(s, 2 in s, len(s))
t = {2, 3, 4}
print(s | t, s & t, s - t, s ^ t, {x % 3 for x in range(10)})
print(set([1, 1, 2]))
