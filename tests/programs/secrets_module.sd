import secrets
import string

print(len(secrets.token_bytes()), len(secrets.token_bytes(16)), secrets.token_bytes(0), secrets.DEFAULT_ENTROPY)
hexed = secrets.token_hex(8)
print(len(hexed), all([c in "0123456789abcdef" for c in hexed]), len(secrets.token_hex()))
safe = secrets.token_urlsafe(30)
print(len(safe), all([c in string.ascii_letters + string.digits + "-_" for c in safe]), len(secrets.token_urlsafe()))
print(secrets.token_bytes(16) != secrets.token_bytes(16), secrets.token_hex(16) != secrets.token_hex(16))

draws = [secrets.randbelow(10) for _ in range(500)]
print(min(draws) >= 0, max(draws) <= 9, len(set(draws)), secrets.randbelow(1))
bits = [secrets.randbits(4) for _ in range(300)]
print(min(bits) >= 0, max(bits) <= 15, len(set(bits)), secrets.randbits(0), 0 <= secrets.randbits(63))
letters = [secrets.choice(string.ascii_lowercase) for _ in range(200)]
print(all([c in string.ascii_lowercase for c in letters]), len(set(letters)) > 10, secrets.choice([7]), secrets.choice((1, 2)) in (1, 2))
password = "".join([secrets.choice(string.ascii_letters + string.digits) for _ in range(12)])
print(len(password), password.isalnum())

print(secrets.compare_digest("abc", "abc"), secrets.compare_digest("abc", "abd"), secrets.compare_digest(b"x", b"x"), secrets.compare_digest("a", "ab"))
for bad in [0, -3]:
    try:
        secrets.randbelow(bad)
    except ValueError as e:
        print("ValueError:", e)
try:
    secrets.token_bytes(-1)
except ValueError as e:
    print("ValueError:", e)
try:
    secrets.choice("")
except IndexError as e:
    print("IndexError:", e)
