# argparse subcommands. Inside `if args.command == "add":` the add subcommand's
# arguments have their own types; elsewhere they're optional (None for other commands).
import argparse

p = argparse.ArgumentParser(prog="todo", description="A to-do list.")
p.add_argument("--db", default="todo.json")
sub = p.add_subparsers(dest="command", required=True, help="what to do")
add = sub.add_parser("add", help="add an item")
add.add_argument("text")
add.add_argument("--priority", type=int, default=1)
rm = sub.add_parser("remove", aliases=["rm"], help="remove an item")
rm.add_argument("index", type=int)
rm.add_argument("-f", "--force", action="store_true")
sub.add_parser("list")
p.print_help()
print("---")
add.print_help()


def run(argv: list[str]):
    args = p.parse_args(argv)
    print(args)
    if args.command == "add":
        print("adding", args.text.upper(), "at priority", args.priority + 0, "to", args.db)
    elif args.command in ("remove", "rm"):
        force = args.force
        print("removing", args.index, "forced" if force else "gently")
    else:
        print("listing", args.command)


run(["add", "milk", "--priority", "3"])
run(["--db", "x.json", "rm", "2", "-f"])
run(["list"])

q = argparse.ArgumentParser(prog="q")
s2 = q.add_subparsers(dest="cmd")
go = s2.add_parser("go")
go.add_argument("--fast", action="store_true")
print(q.parse_args([]), q.format_usage(), end="")
print(q.parse_args(["go", "--fast"]))
