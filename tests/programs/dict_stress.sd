# Randomized inserts/updates/deletes/re-inserts; order and contents must match Python exactly.
seed = [12345]

def rand(n: int) -> int:
    seed[0] = (seed[0] * 1103515245 + 12345) % 2147483648
    return seed[0] % n

d: dict[int, int] = {}
s: dict[str, list[int]] = {}
checksum = 0
for step in range(60000):
    op = rand(10)
    k = rand(700)
    if op < 5:
        d[k] = d.get(k, 0) + step
        s.setdefault(f"k{k % 97}", []).append(step % 7)
    elif op < 8:
        if k in d:
            checksum += d.pop(k)
    elif op == 8:
        d.pop(k, 0)
        key = f"k{k % 97}"
        if key in s:
            del_count = len(s.pop(key))
            checksum += del_count
    else:
        checksum += len(d) + sum(1 for x in d if x % 3 == 0)
    if step % 15000 == 0:
        print(step, len(d), len(s), list(d.keys())[:5], checksum)

print(len(d), sum(d.values()), list(d.items())[:8], list(d.items())[-3:])
print(len(s), sorted(s)[:5], [len(v) for v in list(s.values())[:6]])
print(checksum)
d.clear()
print(d, len(d), 5 in d)
d[5] = 1
print(d)
