# datetime: dates, times, durations and fixed-offset time zones.
import datetime as dtm
from datetime import date, datetime, time, timedelta, timezone

d = date(2024, 5, 17)
dt = datetime(2024, 5, 17, 9, 5)
t = time(12, 30)
print(d, repr(d), dt, repr(dt), repr(datetime(2024, 1, 2, 3, 4, 5, 6)), t, repr(t), repr(time(1, 2, 3, 4)))
print(d.year, d.month, d.day, dt.hour, dt.minute, dt.second, dt.microsecond, dt.tzinfo)
print(d.weekday(), d.isoweekday(), d.toordinal(), date.fromordinal(1), d.replace(day=1), dt.date(), dt.time())

# durations
for td in [timedelta(days=1, hours=2, minutes=3, seconds=4), timedelta(seconds=-1), timedelta(0),
           timedelta(days=2, microseconds=500000), timedelta(days=-3, hours=5), timedelta(weeks=1, milliseconds=1.5)]:
    print(repr(str(td)), repr(td), td.days, td.seconds, td.microseconds)
hour = timedelta(hours=1)
print(hour / timedelta(minutes=7), hour // timedelta(minutes=7), hour % timedelta(minutes=7), hour * 1.5, 2 * hour)
print(hour / 3, hour // 4, -hour, abs(timedelta(hours=-1)), timedelta(days=1).total_seconds(), bool(timedelta(0)))
print(sum([hour, hour, hour], timedelta()) == timedelta(hours=3), max(hour, timedelta(minutes=90)))

# date and datetime arithmetic
print(datetime(2024, 1, 31, 23) + timedelta(hours=2), date(2024, 1, 31) + timedelta(days=30), d - timedelta(weeks=2))
print((date(2024, 3, 1) - date(2024, 2, 1)).days, datetime(2024, 1, 2) - datetime(2024, 1, 1, 12))
print(datetime.combine(d, t), d < date(2025, 1, 1), sorted([date(2024, 3, 1), date(2023, 1, 1)]))
print(len({d, date(2024, 5, 17), date(2024, 5, 18)}))
elapsed = timedelta()
elapsed += timedelta(minutes=45)
elapsed *= 2
print(elapsed)

# formatting
print(dt.isoformat(), dt.isoformat(" ", "minutes"), datetime(2024, 1, 1, 0, 0, 0, 1500).isoformat(timespec="milliseconds"))
print(d.strftime("%A %d %B %Y %j %a %b"), dt.strftime("%Y-%m-%dT%H:%M:%S.%f%z|%Z|"), d.isoformat(), t.isoformat())
print(d.ctime(), dt.strftime("%I:%M %p on %m/%d/%y"))

# parsing
print(datetime.strptime("2024-05-17 09:05:03.25", "%Y-%m-%d %H:%M:%S.%f"))
print(datetime.strptime("17/May/24 3PM +0200", "%d/%b/%y %I%p %z"), datetime.strptime("2024 138", "%Y %j").date())
for text, fmt in [("2024-13-01", "%Y-%m-%d"), ("2024-05-17x", "%Y-%m-%d"), ("nope", "%Y")]:
    try:
        datetime.strptime(text, fmt)
    except ValueError as e:
        print("error:", e)
print(datetime.fromisoformat("2024-05-17T09:05:03.123+02:00"), date.fromisoformat("2024-05-17"))
print(datetime.fromisoformat("2024-05-17"), datetime.fromisoformat("2024-05-17T09:05Z"), time.fromisoformat("10:11:12"))
for bad in ["2024-5-17", "2024-05-17T25:00"]:
    try:
        datetime.fromisoformat(bad)
    except ValueError as e:
        print("error:", e)
try:
    date(2023, 2, 29)
except ValueError as e:
    print("error:", e)
try:
    datetime(2024, 1, 1, 24)
except ValueError as e:
    print("error:", e)

# time zones
utc = timezone.utc
print(utc, repr(utc), timezone(timedelta(hours=2)), repr(timezone(timedelta(hours=2), "CEST")), dtm.UTC == utc)
aware = datetime(2024, 1, 1, 12, tzinfo=utc)
print(aware, repr(aware), aware.utcoffset(), aware.tzname(), dt.utcoffset(), dt.tzname())
print(aware.astimezone(timezone(timedelta(hours=-5))), aware.timestamp(), datetime.fromtimestamp(0, utc))
print(aware == datetime(2024, 1, 1, 14, tzinfo=timezone(timedelta(hours=2))), aware == datetime(2024, 1, 1, 12))
print(aware.strftime("%H:%M %z %Z"), datetime(2024, 5, 17, 9, 5, tzinfo=timezone(timedelta(hours=-5, minutes=-30))))
try:
    print(datetime(2024, 1, 1) < aware)
except TypeError as e:
    print("error:", e)
print(dtm.MINYEAR, dtm.MAXYEAR, dtm.date(2000, 1, 1), dtm.datetime.fromisoformat("2000-01-01T00:00"))

# the clock (only checked, since it changes)
now = datetime.now()
print(now.year >= 2024, datetime.now(utc).tzinfo == utc, date.today() == now.date() or True)
print(abs(datetime.now(utc) - datetime.fromtimestamp(datetime.now(utc).timestamp(), utc)) < timedelta(seconds=1))
